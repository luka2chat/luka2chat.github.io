---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'luka2chat - Indie Maker',
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'View on GitHub',
        href: 'https://github.com/luka2chat',
        icon: 'tabler:arrow-right',
      },
      { variant: 'secondary', text: 'See my work', href: '#projects' },
    ]}
  >
    <Fragment slot="title">
      <span class="italic">Luka</span> — Indie Maker<br /> for AI & GEO
    </Fragment>

    <Fragment slot="subtitle">
      I ship open-source tools for generative engine optimization, making games with AI, and LLM-powered workflows. Building in public, one commit at a time.
    </Fragment>

    <Fragment slot="content">
      <div class="inline-flex items-center gap-6 text-sm text-muted border border-subtle px-6 py-3">
        <span class="uppercase tracking-widest text-xs font-medium">What I ship</span>
        <span class="w-px h-4 bg-[var(--aw-color-border)]"></span>
        <span>Open-source tools · GEO resources · AI experiments</span>
      </div>
    </Fragment>
  </Hero>

  <Features2
    id="projects"
    tagline="01"
    title="What I'm Building"
    subtitle="Open-source projects I'm actively working on — from curated resource lists to an AI toolkit for making games your own."
    items={[
      {
        title: 'awesome-geo',
        description:
          'A curated list of 120+ resources for Generative Engine Optimization (GEO) — optimizing content for AI search engines like ChatGPT, Perplexity, Claude, and Google AI Overviews. 17 stars on GitHub.',
        icon: 'tabler:star',
      },
      {
        title: 'owngame',
        description:
          'An open-source toolkit for making games your own. Play something you like on owngame.dev, click Remix, and hand it to Codex, Cursor, or another MCP agent to change the art and rules into a playable version. Built with TypeScript.',
        icon: 'tabler:device-gamepad-2',
        href: 'https://github.com/luka2chat/owngame',
      },
      {
        title: 'geo-skills',
        description:
          'Production-grade GEO best practices for AI coding agents — 12 rule files covering content strategy, structured data, AI crawler config, llms.txt, and more. Install via npx skills add. Supports Cursor, Claude Code, and 37+ AI agents.',
        icon: 'tabler:robot',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page"></div>
    </Fragment>
  </Features2>

  <Stats
    tagline="02"
    title="GitHub Activity"
    stats={[
      { title: 'Public Repos', amount: '9' },
      { title: 'Stars Earned', amount: '17' },
      { title: 'Contributions', amount: '81' },
      { title: 'Open Source Projects', amount: '3' },
    ]}
  />

  <Brands
    tagline="03"
    title="Tech Stack"
    subtitle="The technologies I use to build things."
    icons={['tabler:brand-typescript', 'tabler:brand-javascript', 'tabler:brand-python', 'tabler:brand-nodejs', 'tabler:brand-react', 'tabler:brand-tailwind', 'tabler:brand-github', 'tabler:brand-vite']}
    images={[]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page"></div>
    </Fragment>
  </Brands>

  <Features
    id="features"
    tagline="04"
    title="What I Focus On"
    subtitle="The areas where I spend most of my time exploring and building."
    columns={3}
    items={[
      {
        title: 'Generative Engine Optimization',
        description:
          'Researching and curating the best practices for optimizing content visibility in AI-powered search engines and LLM-based answer engines.',
        icon: 'tabler:search',
      },
      {
        title: 'LLM-Powered Applications',
        description:
          'Building tools and applications that leverage large language models to solve real problems — automating workflows and creating smarter developer experiences.',
        icon: 'tabler:brain',
      },
      {
        title: 'Making Games with AI',
        description:
          'Building an open-source toolkit so you can play a game you like, hand it to your AI, and remix the art and rules into something of your own.',
        icon: 'tabler:device-gamepad-2',
      },
      {
        title: 'Open Source',
        description:
          'Contributing to and maintaining open-source projects. Everything I build is public and open for collaboration.',
        icon: 'tabler:git-fork',
      },
      {
        title: 'Web Development',
        description:
          'Full-stack web development with modern frameworks — Astro, React, VitePress, Node.js, and more.',
        icon: 'tabler:code',
      },
      {
        title: 'Developer Tools',
        description:
          'Building tools that make developers\' lives easier — from automation scripts to tracking dashboards.',
        icon: 'tabler:tool',
      },
    ]}
  />

  <FAQs
    tagline="05"
    title="Frequently Asked Questions"
    items={[
      {
        title: 'What is awesome-geo?',
        description:
          'awesome-geo is a curated list of 120+ resources for Generative Engine Optimization (GEO). It covers research papers, tools, strategies, and best practices for optimizing content to be cited by AI search engines like ChatGPT, Perplexity, and Google AI Overviews.',
      },
      {
        title: 'What is owngame?',
        description:
          'owngame is an open-source toolkit for making games your own. Play something you like on owngame.dev, click Remix, and give the prompt to Codex, Cursor, or another MCP agent. It changes the art and rules into a playable version that feels like yours. Built with TypeScript.',
      },
      {
        title: 'Are your projects open source?',
        description:
          'Yes! All my projects are open source and available on GitHub. I believe in building in public and collaborating with the community. Feel free to star, fork, or contribute.',
      },
      {
        title: 'Can I contribute to your projects?',
        description:
          'Absolutely! All my projects welcome contributions. Check out the issues on any of my GitHub repos, or open a PR. For awesome-geo, you can submit new resources. For owngame, play templates, case studies, and bug reports are always appreciated.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page"></div>
    </Fragment>
  </FAQs>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Get in touch',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        target: '_blank',
        text: 'Star awesome-geo',
        href: 'https://github.com/luka2chat/awesome-geo',
      },
    ]}
  >
    <Fragment slot="title">Let's build something</Fragment>

    <Fragment slot="subtitle">
      I'm always up for collaborating on open-source projects, AI tools, and GEO research. Got an idea? Let's ship it together.
    </Fragment>
  </CallToAction>
</Layout>
